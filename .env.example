# ─── Resend (contact form email) ──────────────────────────────────────────────
# Create a key at https://resend.com/api-keys with "Sending access".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where website inquiries are delivered. Defaults to brad@bhgsafety.com.
CONTACT_TO_EMAIL=brad@bhgsafety.com

# Sender address. MUST be on a domain verified in Resend
# (https://resend.com/domains) or Resend will reject the send.
CONTACT_FROM_EMAIL="BHG Forklift Training <noreply@send.bhgsafety.com>"
